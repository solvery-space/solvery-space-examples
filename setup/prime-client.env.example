# ============================================================================
# Solvery Platform - Prime Client Configuration
# ============================================================================
# Этот файл содержит все переменные окружения, необходимые для работы
# клиентского приложения prime-client. Обязательные
# переменные должны быть заполнены перед запуском приложения.
# ============================================================================

# ============================================================================
# ОБЩИЕ НАСТРОЙКИ (Common Settings)
# ============================================================================

# Порт, на котором будет запущено приложение
# Влияет на: порт прослушивания HTTP-сервера
# По умолчанию: 3000
# Примечание: в production обычно управляется через Docker или процесс-менеджер
PORT=3000

# ============================================================================
# ИНТЕГРАЦИЯ С BACKEND API
# ============================================================================

# URL бэкенд API сервера (обязательно)
# Используется на стороне сервера фронтенд-приложения. Здесь можно указать как внешний адрес (например, https://api.example.com),
# так и внутренний сетевой адрес для работы внутри Docker-сети (например, http://backend:3001)
# Влияет на: все API-запросы, идущие от серверной части фронтенд-приложения к backend-сервису
# Формат: полный URL без слеша в конце
BACKEND_HOST=http://prime-api:3000

# ============================================================================
# ПРИМЕЧАНИЯ
# ============================================================================
# 1. BACKEND_HOST обязательна для работы приложения
# 2. URL значения должны быть валидными URL без слеша в конце
# ============================================================================

