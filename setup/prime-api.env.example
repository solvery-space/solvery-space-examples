# ============================================================================
# Solvery Platform - Prime API Configuration
# ============================================================================
# Этот файл содержит все переменные окружения, необходимые для работы
# приложения prime-api. Обязательные переменные должны быть заполнены
# перед запуском приложения.
# ============================================================================

# ============================================================================
# ОБЩИЕ НАСТРОЙКИ (Common Settings)
# ============================================================================

# Порт, на котором будет запущено API приложение
# Влияет на: порт прослушивания HTTP-сервера
# По умолчанию: 3000
PORT=3000

# Уровень детализации логирования
# Влияет на: какие сообщения будут записываться в логи (error, warn, info, verbose, debug)
# По умолчанию: info
# Рекомендуется: info для production, debug для разработки / отладки
LOG_LEVEL=info

# Путь к файлу для записи логов ошибок (опционально)
# Влияет на: если задан, ошибки будут дополнительно записываться в указанный файл
# По умолчанию: не задан (логи только в stdout)
ERROR_LOG_PATH=logs/error.log

# Путь к файлу для записи логов доступа (опционально)
# Влияет на: если задан, HTTP-запросы будут записываться в указанный файл
# По умолчанию: не задан (логи только в stdout)
ACCESS_LOG_PATH=logs/access.log

# Базовый URL хоста API (обязательно)
# Влияет на: формирование абсолютных URL для callback'ов, ссылок в уведомлениях, CORS
# Пример: https://example.com (без слеша в конце)
HOST=https://example.com

# URL фронтенд приложения (опционально, но рекомендуется)
# Влияет на: настройки CORS, формирование ссылок в email-уведомлениях, callback URL для OIDC
# Если не задан, используется значение HOST
# Пример: https://example.com (без слеша в конце)
FRONTEND_HOST=https://example.com

# Идентификатор клиента (обязательно)
# Значение предоставляет техническая поддержка платформы
CUSTOMER_ID=solvery-space

# Пути к самоподписанным сертификатам CA (опционально)
# Влияет на: доверие к самоподписанным сертификатам при HTTPS-подключениях к внешним сервисам
# Формат: пути к файлам сертификатов, разделенные запятыми
# По умолчанию: не задан
NODE_EXTRA_CA_CERTS=/usr/src/app/apps/prime-api/cert.pem

# Путь для хранения загруженных изображений
# Влияет на: где будут сохраняться фотографии профилей менторов и аватары пользователей
# По умолчанию: static/images
# Важно: путь должен быть доступен для записи приложением
IMAGE_STORAGE_PATH=static/images

# Временная директория для загрузки файлов (multipart uploads)
# Влияет на: где временно сохраняются загружаемые файлы (XLSX, ZIP) до их обработки
# По умолчанию: /tmp
# Важно: должен быть доступен для записи, иметь достаточно места
FILE_STORAGE_TEMP_DIR=/tmp

# Максимальный размер загружаемого файла в байтах
# Влияет на: ограничение размера файлов при загрузке (например, ZIP-архивов с фотографиями)
# По умолчанию: 1073741824 (1 ГБ)
# Формат: число в байтах
MULTIPART_MAX_FILE_SIZE=1073741824

# ============================================================================
# НАСТРОЙКИ SMTP (Email отправка)
# ============================================================================

# Строка подключения к SMTP серверу (обязательно)
# Влияет на: отправку всех email-уведомлений пользователям
# Формат: smtp://user:password@host:port или smtps://user:password@host:port
# Примеры:
#   - smtp://user:pass@smtp.gmail.com:587 (STARTTLS)
#   - smtps://user:pass@smtp.gmail.com:465 (SMTPS)
SMTP_CONNECTION=smtp://user:password@smtp.example.com:587

# Email-адрес отправителя для заголовка "From" в отправляемых письмах (обязательно)
# Влияет на: какой адрес будет отображаться получателям email-уведомлений
# Пример: no-reply@example.com
SMTP_FROM_HEADER=no-reply@example.com

# Максимальное количество попыток отправки email при ошибке
# Влияет на: сколько раз система попытается отправить email перед тем, как пометить его как неудачный
# По умолчанию: 5
SMTP_MAX_ATTEMPTS=5

# Базовая задержка между повторными попытками отправки email (в миллисекундах)
# Влияет на: начальную задержку перед повторной попыткой отправки (используется в экспоненциальной задержке)
# По умолчанию: 120000 (2 минуты)
SMTP_RETRY_DELAY=120000

# Максимальная задержка между повторными попытками отправки email (в миллисекундах)
# Влияет на: максимальное время ожидания перед повторной попыткой (ограничивает экспоненциальную задержку)
# По умолчанию: 3600000 (1 час)
SMTP_MAX_DELAY=3600000

# Максимальное количество уведомлений для обработки за один раз (батч)
# Влияет на: производительность обработки уведомлений - сколько писем обрабатывается одновременно
# По умолчанию: 100
SMTP_MAX_BATCH_SIZE=100

# ============================================================================
# БАЗА ДАННЫХ (Database)
# ============================================================================

# Строка подключения к PostgreSQL (обязательно)
# Влияет на: все операции с базой данных (чтение, запись, миграции)
# Формат: postgresql://user:password@host:port/database
# Пример: postgresql://postgres:password@localhost:5432/solvery_db
DB_POSTGRESQL_CONNECTION=postgresql://user:password@localhost:5432/solvery_db

# ============================================================================
# СИСТЕМА СООБЩЕНИЙ (Messaging)
# ============================================================================

# Строка подключения к RabbitMQ (обязательно)
# Влияет на: асинхронную обработку задач (уведомления, массовые загрузки фотографий)
# Формат: amqp://user:password@host:port
# Пример: amqp://guest:guest@localhost:5672
MB_RABBITMQ_CONNECTION=amqp://user:password@localhost:5672

# ============================================================================
# АВТОРИЗАЦИЯ И АУТЕНТИФИКАЦИЯ (Authorization & Authentication)
# ============================================================================

# Время жизни сессии авторизации в миллисекундах
# Влияет на: как долго пользователь остается авторизованным без повторного входа
# По умолчанию: 900000 (15 минут)
# Рекомендуется: 900000-1800000 (15-30 минут) для production
AUTHZ_SESSION_LIFETIME=900000

# Включить проверку подозрительных местоположений при авторизации
# Влияет на: безопасность - система будет проверять IP-адреса и блокировать подозрительные входы
# По умолчанию: true
# Значения: true, false, 1, 0
AUTHZ_SUSPICIOUS_LOCATION_CHECK=true

# Завершать предыдущие сессии при новом входе в систему
# Влияет на: безопасность - при новом входе все предыдущие активные сессии пользователя будут завершены
# По умолчанию: true
# Значения: true, false, 1, 0
AUTHZ_ENABLE_PREVIOUS_SESSIONS_TERMINATION=true

# Период партиционирования таблицы сессий авторизации
# Влияет на: производительность БД - как часто создаются новые партиции для таблицы сессий
# По умолчанию: year
# Возможные значения: day, week, month, quarter, year
# Рекомендуется: year для большинства случаев, month для высоконагруженных систем
AUTHZ_SESSION_TABLE_PARTITION_PERIOD=year

# Секретный ключ для шифрования refresh-токенов OIDC (обязательно)
# Влияет на: безопасность хранения refresh-токенов в базе данных (используется AES-256-GCM)
# Важно: должен длиной в 64 символа в кодировке hex, храниться в безопасности
# Формат: шестнадцатеричная строка (hex)
# Пример генерации: openssl rand -hex 64
AUTHN_SECRET_ENCRYPTION_KEY=your-secret-encryption-key-hex-string-here-min-32-chars

# ============================================================================
# OPENID CONNECT (OIDC Integration)
# ============================================================================

# URL для получения конфигурации OpenID Connect (обязательно)
# Влияет на: автоматическое обнаружение эндпоинтов IdP (authorization, token, jwks и т.д.)
# Формат: должен содержать путь .well-known/openid-configuration
# Пример: https://auth.example.com/.well-known/openid-configuration
OPENID_CONNECT_WELL_KNOWN_URL=https://auth.example.com/.well-known/openid-configuration

# Идентификатор клиента OpenID Connect (обязательно)
# Влияет на: аутентификацию приложения в IdP при запросах токенов
# Получается при регистрации OIDC клиента в Identity Provider
OPENID_CONNECT_CLIENT_ID=your-client-id

# Секретный ключ клиента OpenID Connect (обязательно)
# Влияет на: безопасность аутентификации при обмене authorization code на токены
# Получается при регистрации OIDC клиента в Identity Provider
# Важно: хранить в безопасности
OPENID_CONNECT_CLIENT_SECRET=your-client-secret

# Время жизни кэша конфигурации OpenID Connect в миллисекундах
# Влияет на: как часто приложение обновляет конфигурацию IdP (discovery endpoint)
# По умолчанию: 21600000 (6 часов)
# Рекомендуется: 21600000-86400000 (6-24 часа) в зависимости от частоты изменений в IdP
OPENID_CONNECT_CACHE_TTL=21600000

# Кастомный scope для ID токена OpenID Connect (обязательно)
# Влияет на: какие дополнительные данные будут включены в id_token от IdP
# Формат: строка с пробелами между scope'ами
# Примеры: "openid profile email", "openid email solvery"
OPENID_CONNECT_ID_TOKEN_SCOPE=openid profile email

# Тип контента для запросов к token endpoint OIDC (опционально)
# Влияет на: формат отправки данных при обмене authorization code на токены
# По умолчанию: URL_ENCODED
# Возможные значения: URL_ENCODED, FORM_DATA
# Обычно не требует изменения
OPENID_CONNECT_CONTENT_TYPE=URL_ENCODED

# ============================================================================
# КОНФИГУРАЦИЯ ПЛАТФОРМЫ (Platform Configuration)
# ============================================================================

# Email адрес(-а) системного администратора платформы (обязательно)
# Влияет на: создание первого(-ых) системного(-ых) администратора(-ов) при инициализации системы
# Используется для первоначальной настройки и управления платформой
# Важно: рекомендуется использовать сервисные учетные записи, чтобы не привязывать системных администраторов к конкретным пользователям
# Формат: один или несколько валидных email адресов через запятую
PLATFORM_ADMIN_EMAIL=admin@example.com

# ============================================================================
# ПРИМЕЧАНИЯ
# ============================================================================
# 1. Все переменные, помеченные как "обязательно", должны быть заполнены
# 2. Булевы значения (true/false) можно задавать как true/false или 1/0
# 3. URL значения должны быть валидными URL без слеша в конце
# 4. Пути к файлам должны быть абсолютными
# 5. Секретные ключи (AUTHN_SECRET_ENCRYPTION_KEY, OPENID_CONNECT_CLIENT_SECRET)
#    должны быть достаточно сложными и храниться в безопасности
# ============================================================================

